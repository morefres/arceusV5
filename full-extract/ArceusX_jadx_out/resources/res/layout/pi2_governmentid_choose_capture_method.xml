<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.withpersona.sdk2.inquiry.shared.ui.Pi2NavigationBar
            android:id="0x840500b6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:importantForAccessibility="yes"
            android:accessibilityTraversalAfter="0x84050132"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="0x8405003e"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="0x8403000d">
            <TextView
                android:id="0x84050019"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                app:layout_constraintBottom_toTopOf="0x84050097"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="0x84050127"
                style="?attr/textAppearanceSubtitle1"/>
            <TextView
                android:gravity="start"
                android:id="0x84050127"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginVertical="16dp"
                app:layout_constraintBottom_toTopOf="0x84050019"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/textAppearanceHeadline6"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="0x84050097"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toTopOf="0x84050022"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="0x84050019">
                <androidx.cardview.widget.CardView
                    android:id="0x840500aa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:layout_marginVertical="24dp"
                    app:cardCornerRadius="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no">
                        <View
                            android:id="0x84050088"
                            android:background="?attr/colorSecondary"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:alpha="0.2"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.withpersona.sdk2.inquiry.shared.ui.ThemeableLottieAnimationView
                            android:id="0x84050087"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:scaleType="centerCrop"
                            android:layout_marginVertical="48dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintHorizontal_chainStyle="packed"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintVertical_chainStyle="packed"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.withpersona.sdk2.inquiry.shared.ui.PersonaMaterialButton
                android:id="0x84050022"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:contentDescription="@string/pi2_camera_button_description"
                app:iconGravity="textStart"
                app:layout_constraintBottom_toTopOf="0x84050132"
                app:layout_constraintEnd_toEndOf="0x84050097"
                app:layout_constraintStart_toStartOf="0x84050097"
                app:layout_constraintTop_toBottomOf="0x84050097"/>
            <com.withpersona.sdk2.inquiry.shared.ui.PersonaMaterialButton
                android:id="0x84050132"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintEnd_toEndOf="0x84050097"
                app:layout_constraintStart_toStartOf="0x84050097"
                app:layout_constraintTop_toBottomOf="0x84050022"
                style="?attr/materialButtonStyleSecondary"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
